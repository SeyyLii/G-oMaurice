# Copier ce fichier en .env puis renseigner les valeurs

# Mot de passe du compte admin (obligatoire pour retirer des signalements)
ADMIN_PASSWORD=changez-moi

# --- Production (Docker + Caddy) ---
# Nom de domaine public : Caddy obtient le certificat HTTPS automatiquement
DOMAIN=geomaurice.exemple.mu
# 1 derrière Caddy (production), 0 en local sans reverse proxy
TRUST_PROXY=0

# --- Facultatif ---
# Port local de l'application (Docker : publié sur 127.0.0.1 uniquement)
APP_PORT=3000
# Hors Docker : dossier de la base SQLite et des photos
DATA_DIR=./data
