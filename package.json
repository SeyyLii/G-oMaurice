{
  "name": "geomaurice-citizen",
  "version": "0.1.0",
  "private": true,
  "description": "GéoMaurice : carte des vulnérabilités climatiques de Maurice + signalements citoyens (module RSE ENV 5001, Télécom SudParis x CEDTI)",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "tiles": "node scripts/download-tiles.js"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "multer": "^2.5.0",
    "protomaps-leaflet": "^5.1.0"
  }
}
